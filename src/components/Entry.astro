---
import { repoUrl, type Project } from '../data/projects'

interface Props {
  project: Project
  index: number
}

const { project, index } = Astro.props
const num = String(index).padStart(2, '0')
const rot = (index * 47) % 360
const host = new URL(project.live).host
---

<article
  class="entry reveal group relative grid grid-cols-[auto_1fr] gap-x-5 gap-y-4 border-t border-rule py-8 sm:grid-cols-[3.5rem_1fr_auto] sm:gap-x-8 sm:py-10"
  style={`--reveal-delay:${Math.min(index, 6) * 60}ms`}
>
  <div class="flex flex-col items-start gap-3">
    <span class="font-mono text-[0.7rem] tracking-[0.18em] text-ink-soft">{num}</span>
    <span
      class="facet hidden h-10 w-10 rounded-[3px] sm:block"
      style={`--facet-rot:${rot}`}
      aria-hidden="true"></span>
  </div>

  <div class="min-w-0">
    <h3 class="font-serif text-3xl leading-none tracking-[-0.015em] sm:text-4xl">
      {project.name}
    </h3>
    <p class="mt-2 text-[0.7rem] uppercase tracking-[0.2em] text-accent">
      {project.genre}
    </p>
    <p class="mt-4 max-w-[54ch] text-[0.95rem] leading-relaxed text-ink-soft">
      {project.note}
    </p>
    <ul class="mt-4 flex flex-wrap gap-x-2 gap-y-1.5">
      {
        project.stack.map((s) => (
          <li class="rounded-full border border-rule px-2.5 py-0.5 font-mono text-[0.65rem] tracking-[0.06em] text-ink-soft">
            {s}
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class="col-span-2 flex flex-wrap items-center gap-x-6 gap-y-2 sm:col-span-1 sm:flex-col sm:items-end sm:gap-2 sm:self-start sm:text-right"
  >
    <a
      class="text-sm font-medium underline decoration-rule decoration-1 underline-offset-4 transition-colors hover:decoration-accent hover:text-accent"
      href={project.live}
      rel="noopener"
    >
      Visit site <span aria-hidden="true">&#8599;</span>
      <span class="sr-only">{project.name} live at {host}</span>
    </a>
    <a
      class="font-mono text-[0.72rem] tracking-[0.08em] text-ink-soft underline decoration-transparent underline-offset-4 transition-colors hover:text-ink hover:decoration-rule"
      href={repoUrl(project)}
      rel="noopener"
    >
      Facetworks/{project.slug}
    </a>
  </div>
</article>
