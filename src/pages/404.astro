---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Not found — Facetworks" description="That page does not exist.">
  <main
    class="mx-auto flex min-h-[80vh] w-full max-w-[76rem] flex-col justify-center px-5 sm:px-8 lg:px-12"
  >
    <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-soft">404</p>
    <h1 class="mt-4 font-serif text-[clamp(2.4rem,7vw,4.5rem)] leading-[0.95]">
      Nothing filed here.
    </h1>
    <p class="mt-6 max-w-[46ch] leading-relaxed text-ink-soft">
      That page is not part of the index.
    </p>
    <p class="mt-8">
      <a class="underline decoration-rule underline-offset-4 hover:text-accent" href="/"
        >Back to the index</a
      >
    </p>
  </main>
</BaseLayout>
